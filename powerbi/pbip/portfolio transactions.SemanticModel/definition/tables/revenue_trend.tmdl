	measure 'Total revenue current year' = ```
			
			VAR CurrentDate = MAX(revenue_trend[month_date])
			VAR CurrentYear = YEAR(CurrentDate)
			
			VAR YearStartDate = DATE(CurrentYear, 1, 1)
			VAR YearEndDate =  DATE(CurrentYear, 12, 31) 
			
			VAR SelectedMetric = SELECTEDVALUE('executive trend parameter'[executive trend parameter Order], 0)
			
			RETURN
			    SWITCH(
			        SelectedMetric,
			        0,
			            CALCULATE(
			                [Total revenue],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            ),
			        1,
			            CALCULATE(
			                [Transaction count],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            ),
			        2,
			            CALCULATE(
			                [Average transaction],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            )
			    )
			```
		lineageTag: 62c22340-e764-4d11-9240-af43d046b69c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total revenue last year' =
			
			VAR CurrentDate = MAX(revenue_trend[month_date])
			VAR CurrentYear = YEAR(CurrentDate)
			VAR LastYear = CurrentYear - 1
			
			VAR YearStartDate = DATE(LastYear, 1, 1)
			VAR YearEndDate = DATE(LastYear, 12, 31)
			
			VAR SelectedMetric = SELECTEDVALUE('executive trend parameter'[executive trend parameter Order], 0)
			
			RETURN
			    SWITCH(
			        SelectedMetric,
			        0,
			            CALCULATE(
			                [Total revenue],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            ),
			        1,
			            CALCULATE(
			                [Transaction count],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            ),
			        2,
			            CALCULATE(
			                [Average transaction],
			                ALL(revenue_trend[month_date]),
			                DATESBETWEEN(
			                    revenue_trend[month_date],
			                    YearStartDate,
			                    YearEndDate
			                )
			            )
			    )
		lineageTag: ef0d288d-8215-457d-ab78-1768bb22054f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

