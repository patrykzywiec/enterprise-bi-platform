	column 'recency_days (bins)' =
			IF(
				ISBLANK('customer_activity'[recency_days]),
				BLANK(),
				INT('customer_activity'[recency_days] / 200) * 200
			)
		formatString: 0
		lineageTag: 0736803e-09b3-4c6b-be30-80f63a7467d7
		summarizeBy: none

