table customer_activity
	lineageTag: 09671391-b13f-400b-8b15-35d3e96898f8

	measure 'Active Customers' = CALCULATE(DISTINCTCOUNT(customer_activity[client_sk]), customer_activity[is_churned] = FALSE())
		formatString: #,0
		lineageTag: c620eec4-cc6c-4ea8-a286-868d9032aa46

	measure 'Churned Customers' = CALCULATE(DISTINCTCOUNT(customer_activity[client_sk]), customer_activity[is_churned] = TRUE())
		formatString: 0
		lineageTag: a4a1ee90-e622-46fd-a39c-61bc664629ae

	measure 'Total Customers' = DISTINCTCOUNT(customer_activity[client_sk])
		formatString: 0
		lineageTag: 37a2dd4d-c0fa-4219-a5ed-10bd34d6988b

	measure 'Churn Rate' = DIVIDE([Churned Customers], [Total Customers], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 94ff7b8e-9b64-4c01-bdcc-a733b4ae2f19

	measure 'clv activity' = SUMX(customer_activity,customer_activity[customer_lifetime_value])
		lineageTag: f930664b-a3b2-40a4-acdb-b5fa360dcc27

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'avg clv' = AVERAGEX(customer_activity,customer_activity[customer_lifetime_value])
		lineageTag: c3ff368e-402f-400f-a965-865b5621b251

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Recency' =
			
			VAR AvgRecency =
			    CALCULATE(
			        AVERAGEX(customer_activity, customer_activity[recency_days]),
			        customer_activity[is_churned] = TRUE()
			    )
			VAR Years = ROUND(AvgRecency / 365, 1)
			RETURN
			IF(
			    ISBLANK(Years),
			    BLANK(),
			    FORMAT(Years, "0.0") & " years"
			)
		lineageTag: 4b04c4cb-979f-454e-a8bc-3131c1573f76

