		annotation SummarizationSetBy = Automatic

	column 'customer_lifetime_value (bins)' =
			IF(
				ISBLANK('customer_activity'[customer_lifetime_value]),
				BLANK(),
				IF(
					'customer_activity'[customer_lifetime_value] >= 0,
					ROUNDDOWN('customer_activity'[customer_lifetime_value] / 100000, 0) * 100000,
					ROUNDUP('customer_activity'[customer_lifetime_value] / 100000, 0) * 100000
